    {
      "category": "BRIDGE",
      "title": "Fewest edges or least cost?",
      "subtext": "Two goals can give different answers.",
      "contentBox": {
        "boxType": "text",
        "title": "UNWEIGHTED VS WEIGHTED",
        "text": "For an unweighted graph, a shortest path minimises the number of edges. For a weighted graph, it minimises total edge weight."
      },
      "extraBox": {
        "title": "KEY TAKEAWAY",
        "text": "BFS finds fewest-edge paths in unweighted graphs. Dijkstra handles non-negative weighted paths."
      },
