      "category": "LESSON 03",
      "title": "Weigh Your Options",
      "subtext": "The shortest-looking route isn't always cheapest.",
      "contentBox": {
        "boxType": "text",
        "title": "ROUTES HAVE COSTS",
        "text": "A road network can attach time, distance or price to every connection. These numbers are edge weights."
      },
      "extraBox": {
        "title": "KEY TAKEAWAY",
        "text": "Today: add edge weights and compare routes."
      },
      "questionType": "CONTINUE",
      "buttonLabel": "Continue"
    },
