    {
      "category": "WORKED EXAMPLE",
      "title": "Add the weights",
      "subtext": "A path's total cost is the sum of all its edge weights.",
      "contentBox": {
        "boxType": "text",
        "title": "A → C → B → D",
        "text": "A–C costs 2, C–B costs 1, and B–D costs 3.\nTotal = 2 + 1 + 3 = 6."
      },
      "extraBox": {
        "title": "KEY TAKEAWAY",
        "text": "Count connections to describe length in edges; add weights to measure weighted cost."
      },
      "questionType": "CONTINUE",
      "buttonLabel": "Continue"
    },
