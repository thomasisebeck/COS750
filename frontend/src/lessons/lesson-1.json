    {
      "category": "CONCEPT",
      "title": "Follow a path",
      "subtext": "A path is a sequence of connected vertices.",
      "contentBox": {
        "boxType": "text",
        "title": "EXAMPLE: A → C → D",
        "text": "We travel from A to C along an edge, then from C to D along another edge. Each consecutive pair must be connected."
      },

      "extraBox": {
        "title": "KEY TAKEAWAY",
        "text": "A → D is not a direct edge in this graph. A → C → D is a valid path."
      },
