# Optional: for lifelike narration, set this on the server (never VITE_ prefix).
# Add the key to an untracked .env.local file for Vite development,
# or configure it in Vercel's server environment settings.
OPENAI_API_KEY=
# This model's Speech API support is scheduled to end January 2027.
# Keep the value configurable for migration to a later voice service.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
